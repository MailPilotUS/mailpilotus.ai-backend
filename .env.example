# Copy this file to .env and fill in real values before deploying.

PORT=4000
JWT_SECRET=replace-with-a-long-random-string

# Postgres connection string (used once you swap store.js for Prisma)
DATABASE_URL=postgresql://user:password@host:5432/mailpilotus

# RevenueCat webhook shared secret (Project Settings > Integrations > Webhooks)
REVENUECAT_WEBHOOK_SECRET=replace-with-revenuecat-webhook-secret

# SendGrid Inbound Parse (or Mailgun) - only needed if you verify inbound
# request signatures; not required for the basic setup in this repo.
INBOUND_PARSE_VERIFICATION_KEY=
