// MailPilotus data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  passwordHash        String
  forwardingAddress   String   @unique
  revenueCatAppUserId String   @unique
  subscriptionStatus  String   @default("none")
  trialEndsAt         DateTime?
  resetToken          String?
  resetTokenExpiry    DateTime?
  createdAt           DateTime @default(now())

  googleAccessToken   String?
  googleRefreshToken  String?
  googleTokenExpiry   DateTime?

  tasks      Task[]
  contacts   Contact[]
  pushTokens PushToken[]
}

model Contact {
  id              String  @id @default(cuid())
  ownerId         String
  owner           User    @relation(fields: [ownerId], references: [id])
  deviceContactId String?
  name            String
  email           String?
  phone           String?
  createdAt       DateTime @default(now())

  assignedTasks Task[]

  @@unique([ownerId, deviceContactId])
}

model Task {
  id               String   @id @default(cuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])

  fromAddress      String
  fromName         String?
  forwarderAddress String?

  subject          String
  snippet          String?
  body             String?

  rawEmailUrl      String?

  // Original image/screenshot forwarded into MailPilotUs.
  // Stored as binary data so it survives Render restarts.
  originalImage     Bytes?
  originalImageType String?
  originalImageName String?

  status           String   @default("follow_up")

  assignedToId     String?
  assignedTo       Contact? @relation(fields: [assignedToId], references: [id])
  assignedAt       DateTime?

  receivedAt       DateTime @default(now())
  completedAt      DateTime?
  dueDate           DateTime?
}

model PushToken {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
}
